{
  "name": "@tscircuit/compare-glbs",
  "version": "0.0.1",
  "type": "module",
  "module": "lib/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/compare-glbs"
  },
  "publishConfig": {
